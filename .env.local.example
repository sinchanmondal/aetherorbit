# Copy this file to .env.local and fill in the values.
# Every external API has a fallback, so the app runs (with simulated data) even if a key is missing.

# Observer location (defaults to Vallichira, Kottayam district, Kerala)
NEXT_PUBLIC_OBSERVER_NAME="Vallichira, Kerala"
NEXT_PUBLIC_OBSERVER_LAT=9.719833
NEXT_PUBLIC_OBSERVER_LNG=76.651694
NEXT_PUBLIC_OBSERVER_ALT_M=30
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings -> API). The anon key may also be the newer "publishable" key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the daily reminder cron to read every subscriber. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# N2YO satellite tracking (https://www.n2yo.com/api/) - free key after registering
N2YO_API_KEY=

# Open-Meteo needs no key for non-commercial use.
# For a commercial plan, set the customer endpoint and key instead.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_API_KEY=

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# YouTube Data API v3 (Google Cloud Console -> APIs & Services -> Credentials)
# Live search costs 100 quota units; responses are cached for 15 minutes to stay within the 10,000/day default.
YOUTUBE_API_KEY=

# NASA APOD (https://api.nasa.gov). DEMO_KEY works but is heavily rate-limited.
NASA_API_KEY=DEMO_KEY

# The Space Devs Launch Library 2 (free tier: 15 requests/hour; responses cached for 30 minutes)
LAUNCH_LIBRARY_URL=https://ll.thespacedevs.com/2.3.0/launches/upcoming/
LAUNCH_LIBRARY_TOKEN=

# Daily reminder emails (https://resend.com). Without a key the cron runs in dry-run mode.
RESEND_API_KEY=
REMINDER_FROM_EMAIL="AetherOrbit <reminders@yourdomain.com>"
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET". Generate with: openssl rand -hex 32
CRON_SECRET=
